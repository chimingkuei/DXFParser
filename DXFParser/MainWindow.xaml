<Window x:Class="DXFParser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:DXFParser"
        mc:Ignorable="d"
        Closing="WindowClosing" 
        ResizeMode="CanMinimize"
        Title="DXFParser" Height="700" Width="1000" Background="#FF3E6FB3" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5.5*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>
        <Image Grid.Row="1" Grid.Column="1" x:Name="Logo" Margin="22,29,0,0" HorizontalAlignment="Left" Height="141" VerticalAlignment="Top" Width="159" Source="/Icon/DXF.png"/>
        <TabControl Grid.Row="1" Grid.Column="0" x:Name="Log" HorizontalAlignment="Left" Height="175" VerticalAlignment="Top" Width="790" Background="#FFE6F0FF">
            <TabControl.Resources>
                <Style TargetType="RichTextBox">
                    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="IsReadOnly" Value="True" />
                    <Setter Property="DockPanel.Dock" Value="Bottom" />
                </Style>
                <Style TargetType="Paragraph">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="FontSize" Value="16" />
                </Style>
            </TabControl.Resources>
            <TabItem Header="General" Style="{StaticResource BaseTabcontrol}">
                <RichTextBox x:Name="richTextBoxGeneral" Background="#FF43B5BF"/>
            </TabItem>
            <TabItem Header="Warning" Style="{StaticResource BaseTabcontrol}">
                <RichTextBox x:Name="richTextBoxWarning" Background="#FF43AABF"/>
            </TabItem>
            <TabItem Header="Error" Style="{StaticResource BaseTabcontrol}">
                <RichTextBox x:Name="richTextBoxError" Background="#FF43A0BF"/>
            </TabItem>
            <TabItem Header="Debug" Style="{StaticResource BaseTabcontrol}">
                <RichTextBox x:Name="richTextBoxDebug" Background="#FF4396BF"/>
            </TabItem>
        </TabControl>
        <TabControl Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Top" Height="491" Width="992" Background="#FFE6F0FF">
            <TabItem Header="Reading DXF Screen" Style="{StaticResource BaseTabcontrol}">
                <Grid>
                    <ListView Name="DXFListView" Margin="27,16,321,83" MouseLeftButtonUp="DXFListView_MouseLeftButtonUp">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn x:Name="Circle_Item1" DisplayMemberBinding="{Binding circle}"/>
                                <GridViewColumn x:Name="Circle_Item2" DisplayMemberBinding="{Binding center}"/>
                                <GridViewColumn x:Name="Circle_Item3" DisplayMemberBinding="{Binding radius}"/>
                                <GridViewColumn x:Name="Line_Item1" DisplayMemberBinding="{Binding line}"/>
                                <GridViewColumn x:Name="Line_Item2" DisplayMemberBinding="{Binding startpoint}"/>
                                <GridViewColumn x:Name="Line_Item3" DisplayMemberBinding="{Binding endpoint}"/>
                                <GridViewColumn x:Name="Polylines2D_Item1" DisplayMemberBinding="{Binding polylines2D}"/>
                                <GridViewColumn x:Name="Polylines2D_Item2" DisplayMemberBinding="{Binding posX}"/>
                                <GridViewColumn x:Name="Polylines2D_Item3" DisplayMemberBinding="{Binding posY}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <Button x:Name="Open_Reading_DXF" Style="{StaticResource BaseButton}" Margin="13,384,910,6" FontSize="18" Background="#FFE6F0FF" BorderThickness="0" Click="RDS_Btn_Click">
                        <Image x:Name="Open_Reading_DXF_Icon" Source="/Icon/Reading DXF.png" Width="64" Height="71"/>
                    </Button>
                    <TextBox x:Name="Open_Reading_DXF_Path" Style="{StaticResource BaseTextBox}" Tag="請輸入讀取DXF檔路徑!" FontSize="18" Margin="77,396,321,14"/>
                    <GroupBox Style="{StaticResource BaseGroupBox}" Margin="734,28,69,260" Header="DXF數據結構" FontSize="22" Foreground="Black" Background="Teal">
                        <WrapPanel Orientation="Vertical">
                            <RadioButton x:Name="Circle" Style="{StaticResource BaseRadioButton}" Margin="20,10,0,0" Content="Circle" FontSize="18" Width="119"/>
                            <RadioButton x:Name="Line" Style="{StaticResource BaseRadioButton}" Margin="20,10,0,0" Content="Line" FontSize="18"  Width="119"/>
                            <RadioButton x:Name="Polylines2D" Style="{StaticResource BaseRadioButton}" Margin="20,10,0,0" Content="Polylines2D" FontSize="18"  Width="119"/>
                        </WrapPanel>
                    </GroupBox>
                    <Canvas Height="200" Margin="714,235,45,24">
                        <Button x:Name="Read_DXF" Style="{StaticResource CircleButton}" Width="100" Height="100" Click="RDS_Btn_Click" Canvas.Left="60" Canvas.Top="0">
                            <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="16">Read<LineBreak/>DXF</TextBlock>
                        </Button>
                        <Button x:Name="Clear_ListView" Style="{StaticResource CircleButton}" Width="100" Height="100" Click="RDS_Btn_Click" Canvas.Left="0" Canvas.Top="100">
                            <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="16">Clear<LineBreak/>ListView</TextBlock>
                        </Button>
                        <Button x:Name="Export_CSV" Style="{StaticResource CircleButton}" Width="100" Height="100" Click="RDS_Btn_Click" Canvas.Left="120" Canvas.Top="100">
                            <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="16">Export<LineBreak/>CSV</TextBlock>
                        </Button>
                    </Canvas>
                </Grid>
            </TabItem>
            <TabItem Header="Writing DXF Screen" Style="{StaticResource BaseTabcontrol}">
                <Grid>
                    <ListBox x:Name="DXF_CSV_ListBox"  Margin="27,16,321,83" SelectionMode="Extended"/>
                    <Button x:Name="Open_Writing_DXF" Style="{StaticResource BaseButton}" Margin="13,384,910,6" FontSize="18" Background="#FFE6F0FF" BorderThickness="0" Click="WRS_Btn_Click">
                        <Image x:Name="Open_Writing_Dxf_Icon" Source="/Icon/Writing DXF.png" Width="64" Height="71"/>
                    </Button>
                    <TextBox x:Name="Open_Writing_DXF_Path" Style="{StaticResource BaseTextBox}" Tag="請輸入寫入DXF檔路徑!" FontSize="18" Margin="77,396,321,14"/>
                    <WrapPanel Orientation="Horizontal" Margin="694,46,29,143">
                        <Button x:Name="ADD_DXF_CSV" Style="{StaticResource CircleButton}" Width="100" Height="100" Click="WRS_Btn_Click" Canvas.Left="60" Canvas.Top="0" Margin="21,23,0,0">
                            <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="16">Add<LineBreak/>DXF CSV</TextBlock>
                        </Button>
                        <Button x:Name="Delete_DXF_CSV" Style="{StaticResource CircleButton}" Width="100" Height="100" Click="WRS_Btn_Click" Canvas.Left="60" Canvas.Top="0" Margin="21,23,0,0">
                            <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="16">Delete<LineBreak/>DXF CSV</TextBlock>
                        </Button>
                        <Button x:Name="Write_DXF" Style="{StaticResource CircleButton}" Width="100" Height="100" Click="WRS_Btn_Click" Canvas.Left="60" Canvas.Top="0" Margin="21,23,0,0">
                            <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="16">Write<LineBreak/>DXF</TextBlock>
                        </Button>
                        <Button x:Name="Save_Config" Style="{StaticResource CircleButton}" Width="100" Height="100" Click="WRS_Btn_Click" Canvas.Left="60" Canvas.Top="0" Margin="21,23,0,0">
                            <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="16">Save<LineBreak/>Config</TextBlock>
                        </Button>
                    </WrapPanel>
                    <Label x:Name="Polyline2D_PointGroup_Label1" Content="Polylines2D 1組︰" FontSize="22" HorizontalAlignment="Left" Margin="669,341,0,0" VerticalAlignment="Top" Height="40" Width="191"/>
                    <Label x:Name="Polyline2D_PointGroup_Label2" Content="點" FontSize="22" HorizontalAlignment="Left" Margin="953,343,0,0" VerticalAlignment="Top" Height="40" Width="35"/>
                    <xctk:IntegerUpDown x:Name="Polyline2D_PointGroup" Minimum="3" Increment="1" TextAlignment="Center" FontSize="20" Width="100" Height="40" Margin="853,341,33,78"/>
                </Grid>
            </TabItem>
            <TabItem Header="關於" Style="{StaticResource BaseTabcontrol}" PreviewMouseLeftButtonDown="About_Click"/>
        </TabControl>
    </Grid>
</Window>
